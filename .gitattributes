# Keep shell scripts LF-only so they run on the Linux lab box even when edited or
# committed from Windows. Without this, a CRLF leo.sh fails with "bad interpreter: ^M".
*.sh text eol=lf

# Windows launcher files must stay CRLF so cmd.exe/PowerShell parse them reliably.
*.bat text eol=crlf
*.ps1 text eol=crlf
